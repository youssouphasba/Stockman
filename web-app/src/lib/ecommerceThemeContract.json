{
  "contract_version": 4,
  "schema_version": 1,
  "limits": {
    "max_document_bytes": 262144,
    "max_pages": 60,
    "max_sections_per_page": 60,
    "max_blocks_per_section": 60,
    "max_id_length": 64,
    "max_path_length": 80,
    "max_header_pages": 3
  },
  "reserved_paths": [
    "_next", "__", "account", "admin", "api", "assets", "auth", "cart", "catalog",
    "catalogue", "checkout", "contact", "favicon.ico", "features", "login", "logout",
    "orders", "panier", "pay", "preview", "pricing", "privacy", "register",
    "robots.txt", "settings", "shop", "signup", "sitemap.xml", "static", "terms"
  ],
  "page_kinds": ["home", "catalog", "contact", "custom"],
  "page_menus": ["header", "footer", "hidden"],
  "global_groups": {
    "identity": "Identité",
    "style": "Style",
    "header": "En-tête",
    "footer": "Pied de page"
  },
  "global_settings": {
    "site_name": { "type": "text", "max_length": 120, "nullable": true, "group": "identity", "label": "Nom du site", "hint": "Nom affiché dans l'en-tête, le pied de page et les résultats de recherche." },
    "brand_color": { "type": "color", "nullable": true, "group": "identity", "label": "Couleur de marque", "hint": "Couleur des boutons principaux, des badges, des filtres actifs et des accents du site." },
    "logo_asset_id": { "type": "media_id", "nullable": true, "media_kind": "logo", "group": "identity", "label": "Logo", "hint": "Image affichée dans l'en-tête du site. Une image carrée donne le meilleur rendu." },
    "color_scheme": { "type": "enum", "values": ["light", "cream", "dark"], "labels": { "light": "Clair", "cream": "Crème", "dark": "Sombre" }, "nullable": true, "group": "style", "label": "Ambiance", "hint": "Couleurs de fond et de texte du site. Les boutons gardent votre couleur de marque." },
    "font_pairing": { "type": "enum", "values": ["modern", "editorial", "friendly", "technical"], "labels": { "modern": "Moderne", "editorial": "Éditorial", "friendly": "Chaleureux", "technical": "Technique" }, "nullable": true, "group": "style", "label": "Typographie", "hint": "Polices des titres et des textes, choisies pour leur lisibilité." },
    "corner_style": { "type": "enum", "values": ["rounded", "square"], "labels": { "rounded": "Arrondis", "square": "Angles nets" }, "nullable": true, "group": "style", "label": "Forme des éléments" },
    "animation_style": { "type": "enum", "values": ["none", "subtle", "expressive"], "labels": { "none": "Aucune", "subtle": "Discrètes", "expressive": "Expressives" }, "nullable": true, "group": "style", "label": "Animations", "hint": "Apparitions au défilement, effets au survol et transitions. Elles sont coupées pour les visiteurs qui ont demandé moins de mouvement." },
    "header_layout": { "type": "enum", "values": ["logo-left", "logo-center"], "labels": { "logo-left": "Logo à gauche", "logo-center": "Logo centré" }, "nullable": true, "group": "header", "label": "Disposition de l'en-tête" },
    "show_search": { "type": "boolean", "nullable": true, "group": "header", "label": "Recherche dans l'en-tête" },
    "announcement_text": { "type": "text", "max_length": 120, "nullable": true, "group": "header", "label": "Bandeau d'annonce", "hint": "Une information utile tout en haut du site, par exemple vos délais de livraison. Laissez vide pour le masquer." },
    "announcement_link": { "type": "enum", "values": ["none", "catalog", "contact"], "labels": { "none": "Aucun lien", "catalog": "Vers le catalogue", "contact": "Vers le contact" }, "nullable": true, "group": "header", "label": "Lien du bandeau" },
    "footer_text": { "type": "text", "max_length": 300, "nullable": true, "multiline": true, "group": "footer", "label": "Texte du pied de page", "hint": "Présentez la boutique en quelques mots. Laissez vide pour le masquer." }
  },
  "sections": {
    "legacy-storefront": {
      "type_version": 1,
      "label": "Accueil",
      "settings": {
        "site_name": { "type": "text", "max_length": 120, "nullable": true, "label": "Nom du site", "hint": "Nom affiché dans l'en-tête et dans la section de contact." },
        "hero_title": { "type": "text", "max_length": 120, "nullable": true, "label": "Titre d'accueil", "hint": "Message principal affiché en haut de la vitrine." },
        "welcome_message": { "type": "text", "max_length": 600, "nullable": true, "multiline": true, "label": "Message d'accueil", "hint": "Présentez brièvement la boutique, le service ou la livraison." }
      },
      "blocks": {}
    },
    "hero": {
      "type_version": 1,
      "label": "Bannière d'accueil",
      "settings": {
        "heading": { "type": "text", "max_length": 120, "nullable": true, "label": "Titre" },
        "subheading": { "type": "text", "max_length": 600, "nullable": true, "multiline": true, "label": "Texte" },
        "image_asset_id": { "type": "media_id", "nullable": true, "media_kind": "image", "label": "Image", "hint": "Photo large, au format paysage. Sans image, la bannière s'affiche en texte seul." },
        "button_label": { "type": "text", "max_length": 32, "nullable": true, "label": "Texte du bouton", "hint": "Laissez vide pour masquer le bouton." },
        "button_target": { "type": "enum", "values": ["catalog", "contact"], "labels": { "catalog": "Catalogue", "contact": "Contact" }, "nullable": true, "label": "Destination du bouton" },
        "layout": { "type": "enum", "values": ["overlay", "split", "text"], "labels": { "overlay": "Texte sur l'image", "split": "Image à côté du texte", "text": "Texte seul" }, "nullable": true, "label": "Disposition" },
        "height": { "type": "enum", "values": ["compact", "medium", "tall"], "labels": { "compact": "Compacte", "medium": "Moyenne", "tall": "Haute" }, "nullable": true, "label": "Hauteur" },
        "alignment": { "type": "enum", "values": ["left", "center"], "labels": { "left": "À gauche", "center": "Centré" }, "nullable": true, "label": "Alignement du texte" }
      },
      "blocks": {}
    },
    "category-list": {
      "type_version": 1,
      "label": "Catégories",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" },
        "style": { "type": "enum", "values": ["tiles", "chips"], "labels": { "tiles": "Vignettes illustrées", "chips": "Pastilles" }, "nullable": true, "label": "Présentation" },
        "max_items": { "type": "integer", "min": 3, "max": 12, "nullable": true, "label": "Nombre maximal de catégories" }
      },
      "blocks": {}
    },
    "product-grid": {
      "type_version": 1,
      "label": "Sélection de produits",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" },
        "sort": { "type": "enum", "values": ["name", "price_asc", "price_desc"], "labels": { "name": "Ordre alphabétique", "price_asc": "Prix croissant", "price_desc": "Prix décroissant" }, "nullable": true, "label": "Ordre des produits" },
        "max_items": { "type": "integer", "min": 4, "max": 48, "nullable": true, "label": "Nombre de produits" },
        "columns": { "type": "integer", "min": 2, "max": 5, "nullable": true, "label": "Colonnes sur ordinateur" },
        "card_style": { "type": "enum", "values": ["minimal", "bordered", "portrait"], "labels": { "minimal": "Épurée", "bordered": "Encadrée", "portrait": "Portrait" }, "nullable": true, "label": "Style des fiches" },
        "mobile_layout": { "type": "enum", "values": ["grid", "carousel"], "labels": { "grid": "Grille de deux colonnes", "carousel": "Défilement au doigt" }, "nullable": true, "label": "Présentation sur téléphone", "hint": "Laissé vide : grille de deux colonnes." }
      },
      "blocks": {}
    },
    "image-with-text": {
      "type_version": 1,
      "label": "Image et texte",
      "settings": {
        "image_asset_id": { "type": "media_id", "nullable": true, "media_kind": "image", "label": "Image" },
        "heading": { "type": "text", "max_length": 120, "nullable": true, "label": "Titre" },
        "text": { "type": "text", "max_length": 600, "nullable": true, "multiline": true, "label": "Texte" },
        "button_label": { "type": "text", "max_length": 32, "nullable": true, "label": "Texte du bouton", "hint": "Laissez vide pour masquer le bouton." },
        "button_target": { "type": "enum", "values": ["catalog", "contact"], "labels": { "catalog": "Catalogue", "contact": "Contact" }, "nullable": true, "label": "Destination du bouton" },
        "image_position": { "type": "enum", "values": ["left", "right"], "labels": { "left": "Image à gauche", "right": "Image à droite" }, "nullable": true, "label": "Position de l'image" }
      },
      "blocks": {}
    },
    "rich-text": {
      "type_version": 1,
      "label": "Texte",
      "settings": {
        "heading": { "type": "text", "max_length": 120, "nullable": true, "label": "Titre" },
        "text": { "type": "text", "max_length": 1200, "nullable": true, "multiline": true, "label": "Texte" },
        "alignment": { "type": "enum", "values": ["left", "center"], "labels": { "left": "À gauche", "center": "Centré" }, "nullable": true, "label": "Alignement" }
      },
      "blocks": {}
    },
    "features": {
      "type_version": 1,
      "label": "Points forts",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" }
      },
      "blocks": {
        "feature": {
          "type_version": 1,
          "label": "Point fort",
          "settings": {
            "icon": { "type": "enum", "values": ["truck", "map", "card", "chat", "phone", "clock", "shield", "star", "leaf", "gift"], "labels": { "truck": "Livraison", "map": "Retrait", "card": "Paiement", "chat": "Conseil", "phone": "Téléphone", "clock": "Horaires", "shield": "Garantie", "star": "Qualité", "leaf": "Naturel", "gift": "Cadeau" }, "nullable": true, "label": "Icône" },
            "title": { "type": "text", "max_length": 40, "nullable": true, "label": "Titre" },
            "text": { "type": "text", "max_length": 160, "nullable": true, "multiline": true, "label": "Texte" }
          }
        }
      }
    },
    "faq": {
      "type_version": 1,
      "label": "Questions fréquentes",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" }
      },
      "blocks": {
        "question": {
          "type_version": 1,
          "label": "Question",
          "settings": {
            "question": { "type": "text", "max_length": 140, "nullable": true, "label": "Question" },
            "answer": { "type": "text", "max_length": 600, "nullable": true, "multiline": true, "label": "Réponse" }
          }
        }
      }
    },
    "contact": {
      "type_version": 1,
      "label": "Contact",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" },
        "text": { "type": "text", "max_length": 300, "nullable": true, "multiline": true, "label": "Texte" },
        "show_form": { "type": "boolean", "nullable": true, "label": "Formulaire de contact" },
        "show_whatsapp": { "type": "boolean", "nullable": true, "label": "Bouton WhatsApp", "hint": "Affiché seulement si un numéro WhatsApp est enregistré dans les réglages du site." }
      },
      "blocks": {}
    },
    "marquee": {
      "type_version": 1,
      "label": "Bandeau défilant",
      "settings": {
        "speed": { "type": "enum", "values": ["slow", "normal", "fast"], "labels": { "slow": "Lente", "normal": "Normale", "fast": "Rapide" }, "nullable": true, "label": "Vitesse" },
        "style": { "type": "enum", "values": ["accent", "outline"], "labels": { "accent": "Couleur de marque", "outline": "Discret" }, "nullable": true, "label": "Présentation" }
      },
      "blocks": {
        "marquee-item": {
          "type_version": 1,
          "label": "Message",
          "settings": {
            "text": { "type": "text", "max_length": 60, "nullable": true, "label": "Texte", "hint": "Message court, par exemple un service ou une information pratique." }
          }
        }
      }
    },
    "image-banner": {
      "type_version": 1,
      "label": "Bannière promotionnelle",
      "settings": {
        "image_asset_id": { "type": "media_id", "nullable": true, "media_kind": "image", "label": "Image", "hint": "Photo large au format paysage. Sans image, la bannière reste masquée." },
        "heading": { "type": "text", "max_length": 120, "nullable": true, "label": "Titre" },
        "text": { "type": "text", "max_length": 300, "nullable": true, "multiline": true, "label": "Texte" },
        "button_label": { "type": "text", "max_length": 32, "nullable": true, "label": "Texte du bouton", "hint": "Laissez vide pour masquer le bouton." },
        "button_target": { "type": "enum", "values": ["catalog", "contact"], "labels": { "catalog": "Catalogue", "contact": "Contact" }, "nullable": true, "label": "Destination du bouton" },
        "height": { "type": "enum", "values": ["compact", "medium", "tall"], "labels": { "compact": "Compacte", "medium": "Moyenne", "tall": "Haute" }, "nullable": true, "label": "Hauteur" },
        "alignment": { "type": "enum", "values": ["left", "center"], "labels": { "left": "À gauche", "center": "Centré" }, "nullable": true, "label": "Alignement du texte" }
      },
      "blocks": {}
    },
    "featured-collection": {
      "type_version": 1,
      "label": "Collection mise en avant",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre", "hint": "Laissé vide, le nom de la catégorie est affiché." },
        "category": { "type": "text", "max_length": 120, "nullable": true, "source": "categories", "label": "Catégorie", "hint": "Catégorie de votre catalogue dont les produits sont mis en avant." },
        "max_items": { "type": "integer", "min": 4, "max": 24, "nullable": true, "label": "Nombre de produits" },
        "columns": { "type": "integer", "min": 2, "max": 5, "nullable": true, "label": "Colonnes sur ordinateur" },
        "card_style": { "type": "enum", "values": ["minimal", "bordered", "portrait"], "labels": { "minimal": "Épurée", "bordered": "Encadrée", "portrait": "Portrait" }, "nullable": true, "label": "Style des fiches" },
        "mobile_layout": { "type": "enum", "values": ["grid", "carousel"], "labels": { "grid": "Grille de deux colonnes", "carousel": "Défilement au doigt" }, "nullable": true, "label": "Présentation sur téléphone", "hint": "Laissé vide : défilement au doigt." }
      },
      "blocks": {}
    },
    "image-gallery": {
      "type_version": 1,
      "label": "Galerie d'images",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" },
        "layout": { "type": "enum", "values": ["grid", "mosaic"], "labels": { "grid": "Grille régulière", "mosaic": "Mosaïque" }, "nullable": true, "label": "Disposition" }
      },
      "blocks": {
        "gallery-image": {
          "type_version": 1,
          "label": "Image",
          "settings": {
            "image_asset_id": { "type": "media_id", "nullable": true, "media_kind": "image", "label": "Image" },
            "caption": { "type": "text", "max_length": 80, "nullable": true, "label": "Légende" }
          }
        }
      }
    },
    "testimonials": {
      "type_version": 1,
      "label": "Avis clients",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" }
      },
      "blocks": {
        "testimonial": {
          "type_version": 1,
          "label": "Avis",
          "settings": {
            "quote": { "type": "text", "max_length": 400, "nullable": true, "multiline": true, "label": "Avis", "hint": "Uniquement l'avis réel d'un de vos clients, avec son accord." },
            "author": { "type": "text", "max_length": 60, "nullable": true, "label": "Nom du client" },
            "detail": { "type": "text", "max_length": 60, "nullable": true, "label": "Précision", "hint": "Par exemple la ville ou le produit acheté." }
          }
        }
      }
    },
    "catalog": {
      "type_version": 1,
      "label": "Catalogue complet",
      "settings": {
        "heading": { "type": "text", "max_length": 80, "nullable": true, "label": "Titre" },
        "show_filters": { "type": "boolean", "nullable": true, "label": "Filtres par catégorie" },
        "columns": { "type": "integer", "min": 2, "max": 5, "nullable": true, "label": "Colonnes sur ordinateur" },
        "card_style": { "type": "enum", "values": ["minimal", "bordered", "portrait"], "labels": { "minimal": "Épurée", "bordered": "Encadrée", "portrait": "Portrait" }, "nullable": true, "label": "Style des fiches" }
      },
      "blocks": {}
    }
  },
  "models": {
    "legacy-v1": {
      "name": "Stockman Basic",
      "description": "Le site Stockman d'origine : sobre, éprouvé et rapide à mettre en place.",
      "version": "1.0.0",
      "default_plans": ["starter", "pro", "enterprise"],
      "always_available": true,
      "structure_editable": false,
      "custom_pages": false,
      "pages": [
        { "id": "home", "kind": "home", "sections": [{ "id": "storefront", "type": "legacy-storefront" }] }
      ],
      "guided_settings": {
        "global": ["brand_color", "logo_asset_id"],
        "sections": { "legacy-storefront": ["site_name", "hero_title", "welcome_message"] },
        "blocks": {}
      }
    },
    "atelier": {
      "name": "Atelier",
      "description": "Mode, accessoires et créations : grandes images, typographie élégante et produits mis en scène en format portrait.",
      "version": "1.0.0",
      "default_plans": ["starter", "pro", "enterprise"],
      "structure_editable": true,
      "custom_pages": true,
      "global_defaults": { "color_scheme": "cream", "font_pairing": "editorial", "corner_style": "square", "animation_style": "expressive", "header_layout": "logo-center", "show_search": false, "announcement_link": "none" },
      "presets": [
        { "id": "ivoire", "label": "Ivoire", "settings": { "color_scheme": "cream", "font_pairing": "editorial", "corner_style": "square", "animation_style": "expressive" } },
        { "id": "nuit", "label": "Nuit", "settings": { "color_scheme": "dark", "font_pairing": "editorial", "corner_style": "square", "animation_style": "expressive" } },
        { "id": "galerie", "label": "Galerie", "settings": { "color_scheme": "light", "font_pairing": "modern", "corner_style": "square", "animation_style": "subtle" } }
      ],
      "pages": [
        { "id": "home", "kind": "home", "sections": [
          { "id": "hero", "type": "hero", "settings": { "button_label": "Découvrir la collection", "button_target": "catalog", "layout": "overlay", "height": "tall", "alignment": "center" } },
          { "id": "categories", "type": "category-list", "settings": { "heading": "Nos univers", "style": "tiles", "max_items": 6 } },
          { "id": "collection", "type": "featured-collection", "settings": { "max_items": 4, "columns": 4, "card_style": "portrait" } },
          { "id": "promo", "type": "image-banner", "settings": { "button_label": "Découvrir", "button_target": "catalog", "height": "tall", "alignment": "center" } },
          { "id": "selection", "type": "product-grid", "settings": { "heading": "La sélection", "sort": "name", "max_items": 8, "columns": 4, "card_style": "portrait" } },
          { "id": "lookbook", "type": "image-gallery", "settings": { "heading": "En images", "layout": "mosaic" }, "blocks": [{ "id": "galerie-1", "type": "gallery-image" }, { "id": "galerie-2", "type": "gallery-image" }, { "id": "galerie-3", "type": "gallery-image" }, { "id": "galerie-4", "type": "gallery-image" }, { "id": "galerie-5", "type": "gallery-image" }] },
          { "id": "story", "type": "image-with-text", "settings": { "button_target": "contact", "image_position": "left" } },
          { "id": "reviews", "type": "testimonials", "settings": { "heading": "Ils nous ont fait confiance" }, "blocks": [{ "id": "avis-1", "type": "testimonial" }, { "id": "avis-2", "type": "testimonial" }, { "id": "avis-3", "type": "testimonial" }] }
        ] },
        { "id": "catalog", "kind": "catalog", "sections": [
          { "id": "catalog-main", "type": "catalog", "required": true, "settings": { "heading": "Toute la collection", "show_filters": true, "columns": 3, "card_style": "portrait" } }
        ] },
        { "id": "contact", "kind": "contact", "sections": [
          { "id": "contact-main", "type": "contact", "required": true, "settings": { "heading": "Nous écrire", "show_form": true, "show_whatsapp": true } }
        ] }
      ],
      "guided_settings": {
        "global": ["site_name", "brand_color", "logo_asset_id", "color_scheme", "font_pairing", "corner_style", "animation_style", "header_layout", "show_search", "announcement_text", "announcement_link", "footer_text"],
        "sections": {
          "hero": ["heading", "subheading", "image_asset_id", "button_label", "button_target", "layout", "height", "alignment"],
          "category-list": ["heading", "style", "max_items"],
          "product-grid": ["heading", "sort", "max_items", "columns", "card_style", "mobile_layout"],
          "image-with-text": ["image_asset_id", "heading", "text", "button_label", "button_target", "image_position"],
          "rich-text": ["heading", "text", "alignment"],
          "features": ["heading"],
          "faq": ["heading"],
          "contact": ["heading", "text", "show_form", "show_whatsapp"],
          "catalog": ["heading", "show_filters", "columns", "card_style"],
          "marquee": ["speed", "style"],
          "image-banner": ["image_asset_id", "heading", "text", "button_label", "button_target", "height", "alignment"],
          "featured-collection": ["heading", "category", "max_items", "columns", "card_style", "mobile_layout"],
          "image-gallery": ["heading", "layout"],
          "testimonials": ["heading"]
        },
        "blocks": { "feature": ["icon", "title", "text"], "question": ["question", "answer"], "marquee-item": ["text"], "gallery-image": ["image_asset_id", "caption"], "testimonial": ["quote", "author", "detail"] }
      }
    },
    "marche": {
      "name": "Marché",
      "description": "Alimentation et produits du quotidien : catégories visibles d'emblée, grille dense, prix, unités et disponibilité très lisibles.",
      "version": "1.0.0",
      "default_plans": ["starter", "pro", "enterprise"],
      "structure_editable": true,
      "custom_pages": true,
      "global_defaults": { "color_scheme": "light", "font_pairing": "friendly", "corner_style": "rounded", "animation_style": "subtle", "header_layout": "logo-left", "show_search": true, "announcement_link": "contact" },
